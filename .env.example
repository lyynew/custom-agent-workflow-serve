AEGRA_CONFIG=aegra.json
PROJECT_NAME=custom-agent-workflow-serve
DEBUG=true

# Business tables live in the `biz` schema of this database.
DATABASE_URL=postgresql://aegra:aegra@127.0.0.1:5432/ai_service

AUTH_TYPE=custom
# false = single instance with in-process queue. true = shared queue, SSE pubsub
# and quota counters across replicas; requires a reachable Redis.
REDIS_BROKER_ENABLED=false
REDIS_URL=redis://127.0.0.1:6379/0
CRON_ENABLED=false
RUN_MIGRATIONS_ON_STARTUP=true

HOST=127.0.0.1
PORT=2026
SELF_URL=http://127.0.0.1:2026

# Per-application JWT secrets: stored only here, never in the database.
AGRI_JWT_SECRET=replace-me-with-at-least-32-bytes
MGMT_JWT_SECRET=replace-me-with-at-least-32-bytes

# Workflow execution. Keep the run timeout well below the access-token lifetime:
# the background poller reads the run with the caller's token.
WORKFLOW_SYNC_TIMEOUT_SECONDS=30
WORKFLOW_RUN_TIMEOUT_SECONDS=600
WORKFLOW_POLL_INTERVAL_SECONDS=0.3
WORKFLOW_MAX_CONCURRENT_RUNS=8

# Agent tool loop: how many tool rounds one turn may take before it is forced to
# answer. Guards against a model that keeps calling tools.
AGENT_MAX_TOOL_ITERATIONS=4

# Docker Compose only (interpolation for docker-compose.yml).
POSTGRES_USER=aegra
POSTGRES_PASSWORD=replace-me-with-a-strong-password
POSTGRES_DB=ai_service
HOST_PORT=2026
# Demo data created on boot. Clear both in production.
SEED_APPLICATIONS_FILE=seed/applications.example.json
SEED_MODELS_FILE=seed/models.example.json

# Referenced by seed/models.example.json. Only needed when that config is enabled.
OPENAI_API_KEY=

LOG_LEVEL=INFO
ENV_MODE=LOCAL

# Model routing: DEFAULT_MODEL_CONFIG applies to every agent; the per-agent
# override below wins for one agent only (uppercase agent id).
DEFAULT_MODEL_CONFIG=demo
# MODEL_CONFIG_SIMPLE_AGENT=deepseek

# DeepSeek (OpenAI-compatible). Referenced by seed/models.example.json -> "deepseek".
DEEPSEEK_API_KEY=

# Tavily web search (agent tool). Referenced by app/agents/web_search.py.
TAVILY_API_KEY=

# Web search tool budget (0 disables it).
AGENT_MAX_WEB_SEARCHES=3
