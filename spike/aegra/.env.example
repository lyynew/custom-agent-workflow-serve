AEGRA_CONFIG=aegra.json
PROJECT_NAME=aegra-spike
DEBUG=true

DATABASE_URL=postgresql://aegra:aegra@127.0.0.1:5432/aegra

AUTH_TYPE=custom
REDIS_BROKER_ENABLED=false
CRON_ENABLED=false
RUN_MIGRATIONS_ON_STARTUP=true

HOST=127.0.0.1
PORT=2026
SELF_URL=http://127.0.0.1:2026

# Per-app secrets: never store the real values in the database.
AGRI_JWT_SECRET=replace-me
MGMT_JWT_SECRET=replace-me

LOG_LEVEL=INFO
ENV_MODE=LOCAL
