{
  "name": "custom-agent-workflow-serve",
  "dependencies": ["."],
  "graphs": {
    "echo_agent": {
      "path": "./app/agents/implementations/echo_agent.py:graph",
      "description": "Deterministic demo agent with a server-time tool"
    },
    "reverse_agent": {
      "path": "./app/agents/implementations/reverse_agent.py:graph",
      "description": "Deterministic demo agent that reverses user text"
    }
  },
  "auth": {
    "path": "app.auth.manager:auth"
  },
  "http": {
    "app": "app.main:app",
    "enable_custom_route_auth": true
  }
}
