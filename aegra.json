{
  "name": "custom-agent-workflow-serve",
  "dependencies": ["."],
  "graphs": {
    "echo_agent": {
      "path": "./app/agents/implementations/echo_agent.py:graph",
      "description": "Deterministic demo agent with a server-time tool"
    },
    "reverse_agent": {
      "path": "./app/agents/implementations/reverse_agent.py:graph",
      "description": "Deterministic demo agent that reverses user text"
    },
    "llm_agent": {
      "path": "./app/agents/implementations/llm_agent.py:graph",
      "description": "Model-backed agent driven by biz.model_configs"
    },
    "sum_workflow": {
      "path": "./app/workflows/implementations/sum_workflow.py:graph",
      "description": "Minimal workflow: adds two integers"
    },
    "text_stats_workflow": {
      "path": "./app/workflows/implementations/text_stats_workflow.py:graph",
      "description": "Branching workflow: text statistics with a long-text path"
    }
  },
  "auth": {
    "path": "app.auth.manager:auth"
  },
  "http": {
    "app": "app.main:app",
    "enable_custom_route_auth": true
  }
}
